<?xml version="1.0" encoding="UTF-8"?>
<parse-parameters>
	<report-name>test2</report-name>
	<report-type>singleRow</report-type>
	<parseSheets>
		<parseSheet>
			<sheetName>Example3</sheetName>
			<parseRules>
				<parseRule>
					<parse-type>IgnoreNewPageUntil</parse-type>
					<start-col>1</start-col>
					<end-col>6</end-col>
					<start-row />
					<match-string>------</match-string>
					<end-row />
				</parseRule>
				<parseRule>
					<parse-type>NewRowIf</parse-type>
					<start-col>1</start-col>
					<end-col>25</end-col>
					<match-string>notblank</match-string>
					<end-row>0</end-row>
				</parseRule>
				<parseRule>
					<parse-type>IgnoreLineIf</parse-type>
					<start-col>1</start-col>
					<end-col>25</end-col>
					<match-string>blank</match-string>
					<end-row>0</end-row>
				</parseRule>

				<parseRule>
					<parse-type>SelectFieldData</parse-type>
					<start-col>1</start-col>
					<end-col>25</end-col>
					<start-row>1</start-row>
					<end-row>1</end-row>
					<output-field-name>Vendor Name</output-field-name>
					<output-field-type>string</output-field-type>
				</parseRule>
				<parseRule>
					<parse-type>SelectFieldData</parse-type>
					<start-col>27</start-col>
					<end-col>34</end-col>
					<start-row>1</start-row>
					<end-row>1</end-row>
					<output-field-name>Vendor Code</output-field-name>
					<output-field-type>string</output-field-type>
				</parseRule>
				<parseRule>
					<parse-type>SelectFieldData</parse-type>
					<start-col>79</start-col>
					<end-col>86</end-col>
					<start-row>1</start-row>
					<end-row>1</end-row>
					<output-field-name>Date</output-field-name>
					<output-field-type>date</output-field-type>
				</parseRule>
			</parseRules>
		</parseSheet>
	</parseSheets>
</parse-parameters>
