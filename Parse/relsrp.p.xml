<parse-parameters>
 <report-name>test2</report-name>
 <report-type>multiRow</report-type>
 <parseSheets>
  <parseSheet>
   <sheetName>Database</sheetName>
   <parseRules>
    <!-- header rules -->
    <parseRule>
     <parse-type>IgnorePageRows</parse-type>
     <start-col />
     <end-col />
     <start-row>1</start-row>
     <end-row>3</end-row>
    </parseRule>
    <parseRule>
     <parse-type>NewMultiRowIf</parse-type>
     <start-col>1</start-col>
     <end-col>8</end-col>
     <match-string>notblank</match-string>
     <end-row>5</end-row>
    </parseRule>
    <!-- Content to modify - for each column is a Parse Rule -->
    <!-- First Line -->
    <parseRule>
     <parse-type>SelectMultiRowFieldData</parse-type>
     <start-col>10</start-col>
     <end-col>11</end-col>
     <start-row>1</start-row>
     <end-row>1</end-row>
     <output-field-name>Site</output-field-name>
     <output-field-type>string</output-field-type>
    </parseRule>
    <parseRule>
     <parse-type>SelectMultiRowFieldData</parse-type>
     <start-col>44</start-col>
     <end-col>65</end-col>
     <start-row>1</start-row>
     <end-row>1</end-row>
     <output-field-name>Production Line</output-field-name>
     <output-field-type>string</output-field-type>
    </parseRule>
    
    <!-- Second line -->
    <parseRule>
     <parse-type>SelectMultiRowFieldData</parse-type>
     <start-col>11</start-col>
     <end-col>18</end-col>
     <start-row>5</start-row>
     <end-row>5</end-row>
     <output-field-name>Due Date</output-field-name>
     <output-field-type>date</output-field-type>
    </parseRule>
    <parseRule>
     <parse-type>SelectMultiRowFieldData</parse-type>
     <start-col>43</start-col>
     <end-col>60</end-col>
     <start-row>5</start-row>
     <end-row>5</end-row>
     <output-field-name>Item Number</output-field-name>
     <output-field-type>string</output-field-type>
    </parseRule>
    <parseRule>
     <parse-type>SelectMultiRowFieldData</parse-type>
     <start-col>63</start-col>
     <end-col>86</end-col>
     <start-row>5</start-row>
     <end-row>5</end-row>
     <output-field-name>Description</output-field-name>
     <output-field-type>string</output-field-type>
    </parseRule> 
    <parseRule>
     <parse-type>SelectMultiRowFieldData</parse-type>
     <start-col>89</start-col>
     <end-col>100</end-col>
     <start-row>5</start-row>
     <end-row>5</end-row>
     <output-field-name>Qty Sched</output-field-name>
     <output-field-type>currency</output-field-type>
    </parseRule> 
    <parseRule>
     <parse-type>SelectMultiRowFieldData</parse-type>
     <start-col>103</start-col>
     <end-col>114</end-col>
     <start-row>5</start-row>
     <end-row>5</end-row>
     <output-field-name>Qty Comp</output-field-name>
     <output-field-type>currency</output-field-type>
    </parseRule> 
    <parseRule>
     <parse-type>SelectMultiRowFieldData</parse-type>
     <start-col>117</start-col>
     <end-col>128</end-col>
     <start-row>5</start-row>
     <end-row>5</end-row>
     <output-field-name>Open</output-field-name>
     <output-field-type>currency</output-field-type>
    </parseRule>     
   </parseRules>
  </parseSheet>
  <!-- Selection Criteria rules -->
  <parseSheet>
      <sheetName>Criteria</sheetName>
      <parseRules>
        <parseRule>
          <parse-type>AllDataIf	</parse-type>
          <start-col>60	</start-col>
          <end-col>72</end-col>
          <match-string>End of Report</match-string>
          <end-row>0</end-row>
        </parseRule>
        <parseRule>
          <parse-type>SelectAllData</parse-type>
          <start-col>1</start-col>
          <end-col>132</end-col>
          <start-row>1</start-row>
          <end-row>1</end-row>
          <output-field-name>Criteria</output-field-name>
          <output-field-type>string</output-field-type>
        </parseRule>
      </parseRules>
  </parseSheet>
 </parseSheets>
</parse-parameters>
