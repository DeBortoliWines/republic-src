<?xml version="1.0" encoding="UTF-8"?>
<!--
***************************************************************************
** Program:      ppptrp05.p.xml
** Description:  Parse for 3.6.14 
**  Date     Author Notes
** ========================================================================
** 05/05/05 GB     Generate the parse
***************************************************************************
-->
<parse-parameters>
 <report-name>ppptrp05</report-name>
 <report-type>multiRow</report-type>
 <parseSheets>
  <parseSheet>
   <sheetName>Database</sheetName>
   <parseRules>
    <!-- header rules -->
    <parseRule>
     <parse-type>IgnorePageRows</parse-type>
     <start-col />
     <end-col />
     <start-row>1</start-row>
     <end-row>3</end-row>
    </parseRule>
    <parseRule>
     <parse-type>IgnoreNewPageUntil</parse-type>
     <start-col>1</start-col>
     <end-col>27</end-col>
     <start-row />
     <match-string>---------------------------</match-string>
     <end-row />
    </parseRule>
      <parseRule>
         <parse-type>EndSheetIf</parse-type>
         <start-col>1</start-col>
         <end-col>16</end-col>
         <match-string>Report Criteria:</match-string>
         <end-row>10</end-row>
      </parseRule>    
    <parseRule>
     <parse-type>NewMultiRowIf</parse-type>
     <start-col>1</start-col>
     <end-col>12</end-col>
     <match-string>notblank</match-string>
     <end-row>2</end-row>
    </parseRule>
    <!-- Content to modify - for each column is a Parse Rule -->
    <!-- First Line -->
    <parseRule>
     <parse-type>SelectMultiRowFieldData</parse-type>
     <start-col>1</start-col>
     <end-col>12</end-col>
     <start-row>1</start-row>
     <end-row>1</end-row>
     <output-field-name>Item Number</output-field-name>
     <output-field-type>string</output-field-type>
    </parseRule>
    <!-- Second line -->
    <parseRule>
     <parse-type>SelectMultiRowFieldData</parse-type>
     <start-col>3</start-col>
     <end-col>27</end-col>
     <start-row>2</start-row>
     <end-row>2</end-row>
     <output-field-name>Item</output-field-name>
     <output-field-type>string</output-field-type>
    </parseRule>    
    <parseRule>
     <parse-type>SelectMultiRowFieldData</parse-type>
     <start-col>29</start-col>
     <end-col>31</end-col>
     <start-row>1</start-row>
     <end-row>1</end-row>
     <output-field-name>ABC</output-field-name>
     <output-field-type>string</output-field-type>
    </parseRule>
    <parseRule>
     <parse-type>SelectMultiRowFieldData</parse-type>
     <start-col>33</start-col>
     <end-col>45</end-col>
     <start-row>1</start-row>
     <end-row>1</end-row>
     <output-field-name>Qty On Hand</output-field-name>
     <output-field-type>number</output-field-type>
    </parseRule>
    <parseRule>
     <parse-type>SelectMultiRowFieldData</parse-type>
     <start-col>50</start-col>
     <end-col>64</end-col>
     <start-row>1</start-row>
     <end-row>1</end-row>
     <output-field-name>GL Cost</output-field-name>
     <output-field-type>number</output-field-type>
    </parseRule>
    <parseRule>
     <parse-type>SelectMultiRowFieldData</parse-type>
     <start-col>66</start-col>
     <end-col>80</end-col>
     <start-row>1</start-row>
     <end-row>1</end-row>
     <output-field-name>Ext GL Cost</output-field-name>
     <output-field-type>number</output-field-type>
    </parseRule>
    <parseRule>
     <parse-type>SelectMultiRowFieldData</parse-type>
     <start-col>82</start-col>
     <end-col>96</end-col>
     <start-row>1</start-row>
     <end-row>1</end-row>
     <output-field-name>Current Cost</output-field-name>
     <output-field-type>number</output-field-type>
    </parseRule>
    <parseRule>
     <parse-type>SelectMultiRowFieldData</parse-type>
     <start-col>98</start-col>
     <end-col>113</end-col>
     <start-row>1</start-row>
     <end-row>1</end-row>
     <output-field-name>Ext Current Cost</output-field-name>
     <output-field-type>number</output-field-type>
    </parseRule>
    <parseRule>
     <parse-type>SelectMultiRowFieldData</parse-type>
     <start-col>121</start-col>
     <end-col>126</end-col>
     <start-row>1</start-row>
     <end-row>1</end-row>
     <output-field-name>Variance %</output-field-name>
     <output-field-type>percentage</output-field-type>
    </parseRule>

   </parseRules>
  </parseSheet>
  <!-- Selection Criteria rules -->
  <parseSheet>
      <sheetName>Criteria</sheetName>
      <parseRules>
        <parseRule>
          <parse-type>AllDataIf	</parse-type>
          <start-col>60	</start-col>
          <end-col>72</end-col>
          <match-string>End of Report</match-string>
          <end-row>0</end-row>
        </parseRule>
        <parseRule>
          <parse-type>SelectAllData</parse-type>
          <start-col>1</start-col>
          <end-col>132</end-col>
          <start-row>1</start-row>
          <end-row>1</end-row>
          <output-field-name>Criteria</output-field-name>
          <output-field-type>string</output-field-type>
        </parseRule>
      </parseRules>
  </parseSheet>
 </parseSheets>
</parse-parameters>
