<?xml version="1.0" encoding="UTF-8"?>
<!--
***************************************************************************
** Program:      dbarcar3.p.xml
** Description:  Parse for the program dbersrp.p 
**  Date     Author Notes
** ========================================================================
** 05/07/05 GB     Generate the parse
***************************************************************************
-->
<parse-parameters>
  <report-name>test2 </report-name>
  <report-type>singleRow </report-type>
  <parseSheets>
    <parseSheet>
      <sheetName>Database</sheetName>
      <parseRules>
        <!-- header rules -->
        <parseRule>
	  <parse-type>IgnoreNewPageUntil</parse-type>
          <start-col>1</start-col>
          <end-col>5</end-col>
          <start-row />
          <match-string> -----	</match-string>
	  <end-row />
        </parseRule>
	<parseRule>
          <parse-type>NewRowIf</parse-type>
          <start-col>1</start-col>
          <end-col>8</end-col>
	  <match-string>notblank</match-string>
          <end-row>0</end-row>
        </parseRule>
	<!-- Content to modify - for each column is a Parse Rule -->
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>1</start-col>
	  <end-col>8</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Customer</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>10</start-col>
	  <end-col>37</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Name</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>39</start-col>
	  <end-col>58</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>City</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>60</start-col>
	  <end-col>75</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Telephone</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>77</start-col>
	  <end-col>84</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Class</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>86</start-col>
	  <end-col>99</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Deferred</output-field-name>
	  <output-field-type>number</output-field-type>
	</parseRule>	
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>101</start-col>
	  <end-col>114</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Current</output-field-name>
	  <output-field-type>number</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>116</start-col>
	  <end-col>129</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>30 days</output-field-name>
	  <output-field-type>number</output-field-type>
	</parseRule>		
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>131</start-col>
	  <end-col>144</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>60 Days</output-field-name>
	  <output-field-type>number</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>146</start-col>
	  <end-col>159</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>90 Days</output-field-name>
	  <output-field-type>number</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>161</start-col>
	  <end-col>174</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>120 Days</output-field-name>
	  <output-field-type>number</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>176</start-col>
	  <end-col>189</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Balance</output-field-name>
	  <output-field-type>number</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>192</start-col>
	  <end-col>199</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Last Pay</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<!-- end parse rule -->
      </parseRules>
    </parseSheet>
    <!-- Selection Criteria rules -->
    <parseSheet>
      <sheetName>Criteria</sheetName>
      <parseRules>
        <parseRule>
          <parse-type>AllDataIf	</parse-type>
          <start-col>60	</start-col>
          <end-col>72</end-col>
          <match-string>End of Report</match-string>
          <end-row>0</end-row>
        </parseRule>
        <parseRule>
          <parse-type>SelectAllData</parse-type>
          <start-col>1</start-col>
          <end-col>132</end-col>
          <start-row>1</start-row>
          <end-row>1</end-row>
          <output-field-name>Criteria</output-field-name>
          <output-field-type>string</output-field-type>
        </parseRule>
      </parseRules>
    </parseSheet>
  </parseSheets>
</parse-parameters>
  
