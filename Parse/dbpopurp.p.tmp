<?xml version="1.0" encoding="UTF-8"?>
<!--
***************************************************************************
** Program:      dbsaldrp.p.xml
** Description:  Parse for the program dbsaldrp 7.14.14 
** Date     Author Notes
** ========================================================================
** 05/05/05 GB     Generate the parse
***************************************************************************
-->
<parse-parameters>
  <report-name>dbpopurp.p</report-name>
  <report-type>singleRow </report-type>
  <parseSheets>
    <parseSheet>
      <sheetName>Database</sheetName>
      <parseRules>
        <!-- header rules -->
        <parseRule>
	  <parse-type>IgnoreNewPageUntil</parse-type>
          <start-col>1</start-col>
          <end-col>5</end-col>
          <start-row />
          <match-string>-----</match-string>
	  <end-row />
        </parseRule>
           <parseRule>
         <parse-type>EndSheetIf</parse-type>
         <start-col>1</start-col>
         <end-col>16</end-col>
         <match-string>Report Criteria:</match-string>
         <end-row>10</end-row>
      </parseRule>     
	<parseRule>
          <parse-type>NewRowIf</parse-type>
          <start-col>1</start-col>
          <end-col>20</end-col>
	  <match-string>notblank</match-string>
          <end-row>0</end-row>
        </parseRule>
	<!-- Content to modify - for each column is a Parse Rule -->
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>1</start-col>
	  <end-col>8</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Order</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>10</start-col>
	  <end-col>17</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Supplier</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>19</start-col>
	  <end-col>46</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Supplier Name</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>48</start-col>
	  <end-col>55</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Order Date</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>57</start-col>
	  <end-col>64</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Order Date</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
        
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>66</start-col>
	  <end-col>71</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Pur Acc</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>73</start-col>
	  <end-col>76</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>CC</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>78</start-col>
	  <end-col>85</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Project</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>87</start-col>
	  <end-col>94</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Buyer</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>96</start-col>
	  <end-col>103</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Ent By</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>105</start-col>
	  <end-col>112</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Blanket</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>114</start-col>
	  <end-col>117</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Site</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>119</start-col>
	  <end-col>136</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Item Number</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>138</start-col>
	  <end-col>177</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Item Description</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>179</start-col>
	  <end-col>189</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Qty Ordered</output-field-name>
	  <output-field-type>number</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>191</start-col>
	  <end-col>202</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Qty Received</output-field-name>
	  <output-field-type>number</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>203</start-col>
	  <end-col>216</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Purchase Cost</output-field-name>
	  <output-field-type>number</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>217</start-col>
	  <end-col>229</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Qty Ordered Ext Cost</output-field-name>
	  <output-field-type>number</output-field-type>
	</parseRule>
	<!-- end parse rule -->
      </parseRules>
    </parseSheet>
    <!-- Selection Criteria rules -->
    <parseSheet>
      <sheetName>Criteria</sheetName>
      <parseRules>
        <parseRule>
          <parse-type>AllDataIf	</parse-type>
          <start-col>60	</start-col>
          <end-col>72</end-col>
          <match-string>End of Report</match-string>
          <end-row>0</end-row>
        </parseRule>
        <parseRule>
          <parse-type>SelectAllData</parse-type>
          <start-col>1</start-col>
          <end-col>132</end-col>
          <start-row>1</start-row>
          <end-row>1</end-row>
          <output-field-name>Criteria</output-field-name>
          <output-field-type>string</output-field-type>
        </parseRule>
      </parseRules>
    </parseSheet>
  </parseSheets>
</parse-parameters>
  
