<?xml version="1.0" encoding="UTF-8"?>
<!--
***************************************************************************
** Program:      dbglllr2.p.xml
** Description:  Parse for the program 25.10.2
**  Date     Author Notes
** ========================================================================
** 17/06/05 GB     Generate the parse
***************************************************************************
-->
<parse-parameters>
  <report-name>dbglllr2</report-name>
  <report-type>singleRow </report-type>
  <parseSheets>
    <parseSheet>
      <sheetName>Database</sheetName>
      <parseRules>
        <!-- header rules -->
        <parseRule>
	  <parse-type>IgnoreNewPageUntil</parse-type>
          <start-col>1</start-col>
          <end-col>4</end-col>
          <start-row />
          <match-string>----</match-string>
	  <end-row />
        </parseRule>
      <parseRule>
         <parse-type>EndSheetIf</parse-type>
         <start-col>1</start-col>
         <end-col>16</end-col>
         <match-string>Report Criteria:</match-string>
         <end-row>10</end-row>
      </parseRule>        
	<parseRule>
          <parse-type>NewRowIf</parse-type>
          <start-col>1</start-col>
          <end-col>1</end-col>
	  <match-string>notblank</match-string>
          <end-row>0</end-row>
        </parseRule>
	<!-- Content to modify - for each column is a Parse Rule -->
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>1</start-col>
	  <end-col>4</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Enty</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>6</start-col>
	  <end-col>9</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>CC</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>	
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>11</start-col>
	  <end-col>18</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Account</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>20</start-col>
	  <end-col>43</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Account Name</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>45</start-col>
	  <end-col>46</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>T</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>48</start-col>
	  <end-col>61</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>GL Reference</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>63</start-col>
	  <end-col>78</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Document</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>80</start-col>
	  <end-col>81</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>T</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>83</start-col>
	  <end-col>90</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Supplier</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>92</start-col>
	  <end-col>111</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Vendor Name</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>113</start-col>
	  <end-col>120</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Eff Date</output-field-name>
	  <output-field-type>date</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>122</start-col>
	  <end-col>129</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Entered</output-field-name>
	  <output-field-type>date</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>152</start-col>
	  <end-col>159</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Batch</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>	
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>161</start-col>
	  <end-col>174</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Amount</output-field-name>
	  <output-field-type>currency</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>176</start-col>
	  <end-col>199</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Description</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>201</start-col>
	  <end-col>208</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Project</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>210</start-col>
	  <end-col>228</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Project Description</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>	
	<!-- end parse rule -->
      </parseRules>
    </parseSheet>
    <!-- Selection Criteria rules -->
    <parseSheet>
      <sheetName>Criteria</sheetName>
      <parseRules>
        <parseRule>
          <parse-type>AllDataIf	</parse-type>
          <start-col>60	</start-col>
          <end-col>72</end-col>
          <match-string>End of Report</match-string>
          <end-row>0</end-row>
        </parseRule>
        <parseRule>
          <parse-type>SelectAllData</parse-type>
          <start-col>1</start-col>
          <end-col>132</end-col>
          <start-row>1</start-row>
          <end-row>1</end-row>
          <output-field-name>Criteria</output-field-name>
          <output-field-type>string</output-field-type>
        </parseRule>
      </parseRules>
    </parseSheet>
  </parseSheets>
</parse-parameters>
  
