<parse-parameters>
  <report-name>dbmprp02</report-name>
  <report-type>singleRow </report-type>
  <parseSheets>
    <parseSheet>
      <sheetName>Database</sheetName>
      <parseRules>
        <!-- header rules -->
        <parseRule>
	  <parse-type>IgnoreNewPageUntil</parse-type>
          <start-col>1</start-col>
          <end-col>5</end-col>
          <start-row />
          <match-string> -----	</match-string>
	  <end-row />
        </parseRule>
           <parseRule>
         <parse-type>EndSheetIf</parse-type>
         <start-col>1</start-col>
         <end-col>16</end-col>
         <match-string>Report Criteria:</match-string>
         <end-row>10</end-row>
      </parseRule>     
	<parseRule>
          <parse-type>NewRowIf</parse-type>
          <start-col>1</start-col>
          <end-col>20</end-col>
	  <match-string>notblank</match-string>
          <end-row>0</end-row>
        </parseRule>
	<!-- Content to modify - for each column is a Parse Rule -->
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>1</start-col>
	  <end-col>8</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Site</output-field-name>
