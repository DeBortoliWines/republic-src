	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Item Number</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>29</start-col>
	  <end-col>31</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>P/M</output-field-name>
