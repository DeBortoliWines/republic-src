	  <end-col>187</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Message</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>189</start-col>
	  <end-col>212</end-col>
