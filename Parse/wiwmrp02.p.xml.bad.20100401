	  <end-col>240</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Line/ID</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>242</start-col>
