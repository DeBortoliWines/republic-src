<?xml version="1.0" encoding="UTF-8"?>
<!--
***************************************************************************
** Program:      dbapllrp.p.xml
** Description:  Parse for the program dbersrp.p 
**  Date     Author Notes
** ========================================================================
** 05/07/05 GB     Generate the parse
***************************************************************************
-->
<parse-parameters>
  <report-name>test2 </report-name>
  <report-type>singleRow </report-type>
  <parseSheets>
    <parseSheet>
      <sheetName>Database</sheetName>
      <parseRules>
        <!-- header rules -->
        <parseRule>
	  <parse-type>IgnoreNewPageUntil</parse-type>
          <start-col>1</start-col>
          <end-col>4</end-col>
          <start-row />
          <match-string> ----	</match-string>
	  <end-row />
        </parseRule>
        <parseRule>
         <parse-type>EndSheetIf</parse-type>
         <start-col>1</start-col>
         <end-col>16</end-col>
         <match-string>Report Criteria:</match-string>
         <end-row>10</end-row>
      </parseRule>
	<parseRule>
          <parse-type>NewRowIf</parse-type>
          <start-col>1</start-col>
          <end-col>8</end-col>
	  <match-string>notblank</match-string>
          <end-row>0</end-row>
        </parseRule>
	<!-- Content to modify - for each column is a Parse Rule -->
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>1</start-col>
	  <end-col>4</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Entity</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>6</start-col>
	  <end-col>9</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Cost Center</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>11</start-col>
	  <end-col>18</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Account</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>20</start-col>
	  <end-col>43</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Account Name</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>45</start-col>
	  <end-col>52</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Supplier</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>54</start-col>
	  <end-col>81</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Vendor Name</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>	
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>83</start-col>
	  <end-col>90</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Effective Date</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>	
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>92</start-col>
	  <end-col>99</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Date</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
    <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>101</start-col>
	  <end-col>120</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Invoice</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>122</start-col>
	  <end-col>129</end-col>                           
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Batch</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
    <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>131</start-col>
	  <end-col>138</end-col>                           
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Voucher</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
    
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>140</start-col>
	  <end-col>152</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Amount</output-field-name>
	  <output-field-type>number</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>154</start-col>
	  <end-col>177</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Description</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>	
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>179</start-col>
	  <end-col>186</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Project</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>	
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>188</start-col>
	  <end-col>211</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Project Description</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<!-- end parse rule -->
      </parseRules>
    </parseSheet>
    <!-- Selection Criteria rules -->
    <parseSheet>
      <sheetName>Criteria</sheetName>
      <parseRules>
        <parseRule>
          <parse-type>AllDataIf	</parse-type>
          <start-col>60	</start-col>
          <end-col>72</end-col>
          <match-string>End of Report</match-string>
          <end-row>0</end-row>
        </parseRule>
        <parseRule>
          <parse-type>SelectAllData</parse-type>
          <start-col>1</start-col>
          <end-col>132</end-col>
          <start-row>1</start-row>
          <end-row>1</end-row>
          <output-field-name>Criteria</output-field-name>
          <output-field-type>string</output-field-type>
        </parseRule>
      </parseRules>
    </parseSheet>
  </parseSheets>
</parse-parameters>
  
