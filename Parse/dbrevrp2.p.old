<?xml version="1.0" encoding="UTF-8"?>
<!--
***************************************************************************
** Program:      dbrevrp2.p.xml
** Description:  Parse for the program dbreppr1 18.20.12 
**  Date     Author Notes
** ========================================================================
** 05/05/05 GB     Generate the parse
** 10/06/05 GB     subtotals and totals are not send it to the spreedsheet.
**                 (Req by BR)
**                 check 1-30 = not blank create the new line
***************************************************************************
-->
<parse-parameters>
  <report-name>test2 </report-name>
  <report-type>singleRow </report-type>
  <parseSheets>
    <parseSheet>
      <sheetName>Database</sheetName>
      <parseRules>
        <!-- header rules -->
        <parseRule>
	  <parse-type>IgnoreNewPageUntil</parse-type>
          <start-col>1</start-col>
          <end-col>5</end-col>
          <start-row />
          <match-string> -----	</match-string>
	  <end-row />
        </parseRule>
     <parseRule>
         <parse-type>EndSheetIf</parse-type>
         <start-col>1</start-col>
         <end-col>16</end-col>
         <match-string>Report Criteria:</match-string>
         <end-row>10</end-row>
      </parseRule>
	<parseRule>
          <parse-type>NewRowIf</parse-type>
          <start-col>1</start-col>
          <end-col>30</end-col>
	  <match-string>notblank</match-string>
          <end-row>0</end-row>
        </parseRule>
	<!-- Content to modify - for each column is a Parse Rule -->
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>1</start-col>
	  <end-col>8</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Line</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>10</start-col>
	  <end-col>13</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Line2</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>15</start-col>
	  <end-col>22</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Type</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>24</start-col>
	  <end-col>41</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Comp Item</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>43</start-col>
	  <end-col>44</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>UM</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>46</start-col>
	  <end-col>69</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Comp Desc</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
       <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>71</start-col>
	  <end-col>78</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Site</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
       <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>80</start-col>
	  <end-col>87</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Location</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>	
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>89</start-col>
	  <end-col>106</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Lot/Serial</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>108</start-col>
	  <end-col>115</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>ID</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>117</start-col>
	  <end-col>134</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>F/P Item </output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>136</start-col>
	  <end-col>143</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Eff Date</output-field-name>
	  <output-field-type>date</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>145</start-col>
	  <end-col>146</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>St</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>148</start-col>
	  <end-col>157</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Qty Issued</output-field-name>
	  <output-field-type>currency</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>159</start-col>
	  <end-col>170</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Frozen BOM Expl</output-field-name>
	  <output-field-type>currency</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>172</start-col>
	  <end-col>182</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Issued vs Frozen BOM Qty Var</output-field-name>
	  <output-field-type>currency</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>184</start-col>
	  <end-col>192</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Material Var %</output-field-name>
	  <output-field-type>currency</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>194</start-col>
	  <end-col>204</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Frozen Std Cost</output-field-name>
	  <output-field-type>currency</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>206</start-col>
	  <end-col>218</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Issued vs Frozen Var @ Fzn Std</output-field-name>
	  <output-field-type>currency</output-field-type>
	</parseRule>
	<!-- end parse rule -->
      </parseRules>
    </parseSheet>
    <!-- Selection Criteria rules -->
    <parseSheet>
      <sheetName>Criteria</sheetName>
      <parseRules>
        <parseRule>
          <parse-type>AllDataIf	</parse-type>
          <start-col>60	</start-col>
          <end-col>72</end-col>
          <match-string>End of Report</match-string>
          <end-row>0</end-row>
        </parseRule>
        <parseRule>
          <parse-type>SelectAllData</parse-type>
          <start-col>1</start-col>
          <end-col>132</end-col>
          <start-row>1</start-row>
          <end-row>1</end-row>
          <output-field-name>Criteria</output-field-name>
          <output-field-type>string</output-field-type>
        </parseRule>
      </parseRules>
    </parseSheet>
  </parseSheets>
</parse-parameters>
