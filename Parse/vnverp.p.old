<?xml version="1.0" encoding="UTF-8"?>
<!--
***************************************************************************
** Program:      dbvnverp.p.xml
** Description:  Parse for the program dbvnverp.p 
**  Date     Author Notes
** ========================================================================
** 23/01/08 UK     Generate the parse
***************************************************************************
-->
<parse-parameters>
  <report-name>test2 </report-name>
  <report-type>singleRow </report-type>
  <parseSheets>
    <parseSheet>
      <sheetName>Database</sheetName>
      <parseRules>
        <!-- header rules -->
        <parseRule>
	  <parse-type>IgnoreNewPageUntil</parse-type>
          <start-col>1</start-col>
          <end-col>5</end-col>
          <start-row />
          <match-string> -----	</match-string>
	  <end-row />
        </parseRule>
      <parseRule>
         <parse-type>EndSheetIf</parse-type>
         <start-col>1</start-col>
         <end-col>16</end-col>
         <match-string>Report Criteria:</match-string>
         <end-row>10</end-row>
      </parseRule>
	<parseRule>
          <parse-type>NewRowIf</parse-type>
          <start-col>1</start-col>
          <end-col>44</end-col>
	  <match-string>notblank</match-string>
          <end-row>0</end-row>
        </parseRule>
	<!-- Content to modify - for each column is a Parse Rule -->
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>1</start-col>
	  <end-col>8</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Grower</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>10</start-col>
	  <end-col>29</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Name</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>31</start-col>
	  <end-col>38</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Vineyard</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>40</start-col>
	  <end-col>49</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Block</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>51</start-col>
	  <end-col>58</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Variety</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>60</start-col>
	  <end-col>73</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Variety Name</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>	
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>75</start-col>
	  <end-col>80</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Active</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>	
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>82</start-col>
	  <end-col>89</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Contract</output-field-name>
	  <output-field-type>string</output-field-type>
	</parseRule>	
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>91</start-col>
	  <end-col>93</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>%</output-field-name>
	  <output-field-type>number</output-field-type>
	</parseRule>	
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>95</start-col>
	  <end-col>102</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Hectares</output-field-name>
	  <output-field-type>number</output-field-type>
	</parseRule>
        <parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>104</start-col>
	  <end-col>113</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>This Year Estimate(Tonnes)</output-field-name>
	  <output-field-type>number</output-field-type>
	</parseRule>	
	<parseRule>
	  <parse-type>SelectFieldData</parse-type>
	  <start-col>115</start-col>
	  <end-col>126</end-col>
	  <start-row>1</start-row>
	  <end-row>1</end-row>
	  <output-field-name>Est.Yield/Ha</output-field-name>
	  <output-field-type>number</output-field-type>
	</parseRule>	
	<!-- end parse rule -->
      </parseRules>
    </parseSheet>
    <!-- Selection Criteria rules -->
    <parseSheet>
      <sheetName>Criteria</sheetName>
      <parseRules>
        <parseRule>
          <parse-type>AllDataIf	</parse-type>
          <start-col>60	</start-col>
          <end-col>72</end-col>
          <match-string>End of Report</match-string>
          <end-row>0</end-row>
        </parseRule>
        <parseRule>
          <parse-type>SelectAllData</parse-type>
          <start-col>1</start-col>
          <end-col>132</end-col>
          <start-row>1</start-row>
          <end-row>1</end-row>
          <output-field-name>Criteria</output-field-name>
          <output-field-type>string</output-field-type>
        </parseRule>
      </parseRules>
    </parseSheet>
  </parseSheets>
</parse-parameters>
  
