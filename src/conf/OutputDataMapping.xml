<?xml version="1.0" ?>
<!DOCTYPE mapping PUBLIC "-//EXOLAB/Castor Object Mapping DTD Version 1.0//EN" "http://castor.exolab.org/mapping.dtd" >
<mapping>
  <description>Output Data Rows Mapping</description>
  
  <!-- Data contains Beans contains rows contains columns..  -->
  <class name="org.republic.OutputDataColumn">
    <field name="columnFieldType" type="string"/>
    <field name="columnValue" type="string"/>
  </class>
  <class name="org.republic.OutputDataRow">
    <map-to xml="outputDataRow"/>
    <field name="outputDataColumns" type="org.republic.OutputDataColumn" collection="collection">
      <bind-xml name="outputDataColumn" location="outputDataColumns"/>
    </field>
	
  </class>
  
  <class name="org.republic.OutputDataBean">
    <field name="dataBaseName" type="string"/>

    <field name="outputDataColumnNames" type="string" collection="collection" required="optional">
      <bind-xml name="outputDataColumnName" location="outputDataColumnNames"/>
    </field>
    <field name="outputDataRows" type="org.republic.OutputDataRow" collection="collection">
      <bind-xml name="outputDataRow" location="outputDataRows"/>
    </field>
  </class>
  
   <class name="org.republic.OutputData">
    <field name="outputDataBeans" type="org.republic.OutputDataBean" collection="collection">
      <bind-xml name="outputDataBean" location="outputDataBeans"/>
    </field>
  </class>
  
  
</mapping>
